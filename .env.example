# Ve a tu proyecto en https://supabase.com/dashboard -> Project Settings -> API

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRETA, solo servidor). Se usa para crear cuentas de
# alumnos desde el panel de docente. NUNCA la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# API key de Anthropic (console.anthropic.com), SECRETA. Se usa para generar
# preguntas de examen con IA desde el panel de docente.
ANTHROPIC_API_KEY=

# API key de Resend (resend.com), SECRETA. Se usa para avisarle por correo
# a los docentes de una materia cuando un alumno entrega una tarea o
# presenta un examen. Sin esta variable, la plataforma sigue funcionando
# normal, solo que no se envían esos correos.
RESEND_API_KEY=

# Remitente de esos correos. Mientras no verifiques un dominio propio en
# Resend, deja el de pruebas (onboarding@resend.dev) — pero solo llegan a
# la cuenta con la que te registraste en Resend. Para que le llegue a
# todos los docentes hay que verificar un dominio propio.
RESEND_FROM_EMAIL="JOM Preuniversitario <onboarding@resend.dev>"

# URL pública de la plataforma, para armar el link "Ir a la plataforma"
# dentro de esos correos.
NEXT_PUBLIC_SITE_URL=https://jom-preuniversitario.vercel.app
