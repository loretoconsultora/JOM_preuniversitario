# Ve a tu proyecto en https://supabase.com/dashboard -> Project Settings -> API

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRETA, solo servidor). Se usa para crear cuentas de
# alumnos desde el panel de docente. NUNCA la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# API key de Anthropic (console.anthropic.com), SECRETA. Se usa para generar
# preguntas de examen con IA desde el panel de docente.
ANTHROPIC_API_KEY=
